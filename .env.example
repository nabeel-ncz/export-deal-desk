# PayPal Sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AI Studio key (aistudio.google.com)
GEMINI_API_KEY=

# Optional. Comma-separated Gemini models, tried in order when one is overloaded or out of quota.
# A free-tier key allows only about 20 requests per day per model, and one negotiation uses 10 to 15,
# so a public demo needs billing enabled on the key.
GEMINI_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-flash-lite-latest

# Optional. Leave empty to use the embedded Postgres (PGlite) stored in .data/
DATABASE_URL=
# Optional. Where PGlite stores data, or "memory" to keep it in RAM.
PGLITE_DIR=

# Optional. Public https URL of this app. When set, the PayPal webhook is registered automatically at startup.
# Render sets RENDER_EXTERNAL_URL itself, so leave this empty there.
PUBLIC_URL=
# Optional. Use an existing PayPal webhook ID instead of registering one.
PAYPAL_WEBHOOK_ID=

# Optional. Cap on deals started per hour, to protect a shared AI key on a public demo.
MAX_DEALS_PER_HOUR=30

PORT=3000
